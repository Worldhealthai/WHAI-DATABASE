# ── Database ────────────────────────────────────────────────────────────────
# Supabase (Project Settings → API keys in the Supabase dashboard).
#
# Today: the CRM's own Supabase project, tables in its public schema.
#   NEXT_PUBLIC_SUPABASE_URL   = the CRM project's URL
#   SUPABASE_SERVICE_ROLE_KEY  = the CRM project's service_role key
#   CRM_DB_SCHEMA              = leave unset
#
# After the move into Nexus (see README.md, "Moving the CRM's data into
# Nexus"): the Nexus project, tables in its crm schema.
#   NEXT_PUBLIC_SUPABASE_URL   = the Nexus project's URL
#   SUPABASE_SERVICE_ROLE_KEY  = the Nexus project's service_role (secret) key
#   CRM_DB_SCHEMA              = crm
# With CRM_DB_SCHEMA=crm the CRM refuses to build or start without the
# service role key; it never uses the anon key on the Nexus project.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# CRM_DB_SCHEMA="crm"

# Only read when CRM_DB_SCHEMA is unset and SUPABASE_SERVICE_ROLE_KEY is
# missing (the CRM's own project, as before). Not needed once the service
# role key is set, and never used with CRM_DB_SCHEMA=crm: delete it when
# the CRM moves into Nexus (README.md, step 5).
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Shared secret for the website → CRM registration webhook.
# MUST be the exact same value as CRM_WEBHOOK_SECRET on the
# -world-health-ai (website) Vercel project, or forwarding fails with 401.
WEBHOOK_SECRET="generate-one-long-random-string-and-use-it-in-both-projects"

# Pulse AI assistant
ANTHROPIC_API_KEY="sk-ant-..."
